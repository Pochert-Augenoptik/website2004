---
import { Font, getImage } from "astro:assets";
import logoSrc from "../assets/logo.png";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";

const logoPreload = await getImage({ src: logoSrc, height: 100, format: "avif" });

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Augenoptik Pochert - Der Optiker der für Sie Zeit hat",
  description = "Augenoptik Pochert in Freital - Der Optiker der für Sie Zeit hat. Individuelle Brillen, Sehtests, Kontaktlinsen und erstklassiger Service. Seit 1929.",
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <title>{title}</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preload" href={logoPreload.src} as="image" type="image/avif" />
    <Font cssVariable="--font-alan-sans" preload />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Zum Inhalt springen</a>
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 9999;
    padding: 0.5rem 1rem;
    background: var(--color-primary-dark);
    color: var(--color-on-primary);
    font-weight: 600;
    border-radius: 0 0 4px 4px;
    text-decoration: none;

    &:focus {
      top: 0;
    }
  }
</style>
